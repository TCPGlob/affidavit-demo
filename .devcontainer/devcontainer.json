{
  "name": "Document Preparation Pipeline (demo)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install pymupdf pillow openpyxl",
  "postAttachCommand": "python pipeline.py review --demo --host 0.0.0.0 --port 8765 --no-browser",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Preparation console (demo)",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": false
      }
    }
  }
}
