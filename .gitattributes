# Normalise line endings in the repository to LF.
#
# Without this, Git on Windows rewrites text files to CRLF on checkout, which
# shows up as spurious diffs and can break the Linux CI job and the Docker build.
# Shell scripts and Dockerfiles must be LF or they fail at run time.

* text=auto eol=lf

# Explicit, so a Windows checkout cannot convert them.
*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows batch files MUST end each line with CRLF. With LF-only endings the
# command interpreter can misread them, and these are the files a non-technical
# user is told to double-click.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# macOS/Linux launcher: must be LF, or the kernel rejects the shebang.
*.command text eol=lf

# Binary - never touch these.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.sqlite3 binary
*.ico   binary
